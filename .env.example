# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_DB=hono_starter
POSTGRES_USER=user123
POSTGRES_PASSWORD=user123

# Application Database URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Set true only when a trusted proxy overwrites X-Forwarded-For
TRUST_PROXY=false

# Maximum accepted request body size in bytes
BODY_LIMIT_BYTES=102400

# Mail Configuration
MAIL_SERVICE=Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=no-reply@example.com

# JWT Configuration, secrets must be at least 32 characters
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32-value-aaaa
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32-value-bbbb
# Access token lifetime in hours
ACCESS_TOKEN_EXPIRES_IN=3
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRES_IN=30

# Google OAuth Configuration
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google
