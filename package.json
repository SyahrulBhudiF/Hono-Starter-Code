{
	"name": "Hono-Starter-Code",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"seed": "bun run src/config/db/seed.ts",
		"migrate": "bunx drizzle-kit generate && bunx drizzle-kit migrate",
		"worker": "bun run src/worker.ts",
		"lint": "bunx biome lint .",
		"lint:fix": "bunx biome lint --write .",
		"format": "bunx biome format .",
		"format:fix": "bunx biome format --write .",
		"check": "bunx biome check .",
		"check:fix": "bunx biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@faker-js/faker": "^10.5.0",
		"@hono/oauth-providers": "^0.8.7",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.5.1",
		"@scalar/hono-api-reference": "^0.11.12",
		"@types/nodemailer": "^8.0.1",
		"bull": "^4.16.5",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"drizzle-seed": "^0.3.1",
		"hono": "^4.13.0",
		"ioredis": "^6.0.0",
		"nodemailer": "^9.0.4",
		"pg": "^8.22.0",
		"swagger-ui-dist": "^5.32.12",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.20.4",
		"@vitest/coverage-v8": "^4.1.10",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.5",
		"vitest": "^4.1.10"
	}
}
